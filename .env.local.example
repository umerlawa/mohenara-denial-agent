# Copy to .env.local and fill in. .env.local is gitignored and must never
# appear in a committed file, a log, or a pull request.
#
# Bedrock -- the $50 build budget. us.* cross-region inference profiles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Anthropic first-party -- the $9 frontier-comparison budget, and nothing else.
# Leave empty unless you are running that phase; spend.py gates it separately
# and the two budgets never mix.
ANTHROPIC_API_KEY=

# --- Optional: raise the caps for a demo or a deployment --------------------
# The values in config/models.json are BUILD guardrails. Override them here
# rather than editing that tracked file, or you get a merge conflict on every
# pull. Keep the stop below the ceiling: eval runs halt at the stop, so a stray
# eval can never consume the headroom a live demo needs.
#
# MOHENARA_BUDGET_ANTHROPIC=250
# MOHENARA_STOP_ANTHROPIC=200
# MOHENARA_BUDGET_BEDROCK=250
# MOHENARA_STOP_BEDROCK=200
