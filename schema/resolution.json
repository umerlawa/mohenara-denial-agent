{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohenara.local/schema/resolution.json",
  "title": "Denial resolution",
  "description": "One resolution emitted by the denial-resolution system for one case. A resolution is in exactly one of two states: it is resolved, or it is parked awaiting a fact only a human can supply. The two states carry disjoint required payloads, so a consumer can branch on `status` alone.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "input_format",
    "status",
    "rationale",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^MOH2-[0-9]{6}$"
    },
    "input_format": {
      "description": "Which artifact form the system actually read.",
      "enum": [
        "md",
        "edi"
      ]
    },
    "status": {
      "description": "resolved: root cause and next action are both determined. awaiting_human: the system reached a fact it cannot obtain from the case artifacts and has stopped rather than guess.",
      "enum": [
        "resolved",
        "awaiting_human"
      ]
    },
    "rationale": {
      "description": "Short human-readable explanation, for an RCM operator reading one case. Not scored; free text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "resolution": {
      "type": "object",
      "required": [
        "root_cause",
        "next_action",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "root_cause": {
          "type": "object",
          "required": [
            "family",
            "explanation"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "description": "Scored field. The defect family, or `none` for a clean claim that was paid correctly.",
              "enum": [
                "none",
                "cob_other_primary",
                "eligibility_terminated",
                "exact_duplicate",
                "missing_referring_provider",
                "missing_therapy_modifier",
                "mue_exceeded",
                "ncci_ptp_no59",
                "threshold_no_kx",
                "timely_filing"
              ]
            },
            "explanation": {
              "description": "Why this family, citing the specific artifact facts that establish it.",
              "type": "string",
              "minLength": 1,
              "maxLength": 700
            }
          }
        },
        "next_action": {
          "type": "object",
          "required": [
            "path",
            "detail"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "Scored field. The concrete disposition for this claim.",
              "enum": [
                "none",
                "appeal",
                "bill_patient",
                "correct_and_resubmit",
                "do_not_resubmit",
                "resubmit_other_payer"
              ]
            },
            "detail": {
              "description": "The specific operator instruction: what to change, where to send it, under what frequency code, by when.",
              "type": "string",
              "minLength": 1,
              "maxLength": 700
            },
            "resubmission_frequency_code": {
              "description": "X12 CLM05-3 claim frequency code, when a corrected or voided claim is going out. 7 = replacement, 8 = void. Omit when no claim is being resubmitted.",
              "enum": [
                "7",
                "8"
              ]
            }
          }
        },
        "denial": {
          "description": "The adjudication codes carried on the remit, as read from the case. Null for a clean claim.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "group",
            "carc"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "enum": [
                "CO",
                "PR",
                "OA",
                "PI"
              ]
            },
            "carc": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{1,4}$"
            },
            "rarc": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z][0-9A-Za-z]{1,5}$"
            },
            "level": {
              "enum": [
                "claim",
                "line"
              ]
            }
          }
        },
        "denied_line_idxs": {
          "description": "Zero-based indices of the denied service lines.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "evidence": {
          "description": "The artifacts the conclusion actually rests on. Must be non-empty: a resolution with no cited evidence is a guess.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "fact"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "enum": [
                  "none",
                  "ack_277ca.edi",
                  "chart_note.txt",
                  "claim_837p.edi",
                  "eligibility_270.edi",
                  "eligibility_271.edi",
                  "remit_835.edi",
                  "case.md",
                  "human_input",
                  "reference"
                ]
              },
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "locator": {
                "description": "Where in the artifact, e.g. a segment id or line number.",
                "type": "string",
                "maxLength": 200
              },
              "segments": {
                "description": "The exact segments this fact rests on. Optional, and absent on the predictions recorded before segment provenance existed.",
                "type": "array",
                "maxItems": 12,
                "items": {
                  "description": "One source segment, quoted verbatim. `text` must be the line EXACTLY as it appears in the artifact, because a view anchors the annotation by matching it; a paraphrase anchors nothing and is dropped.",
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "description": "1-based line number within the artifact, if known. Used only to disambiguate when `text` occurs more than once."
                    },
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 12,
                      "description": "EDI segment id, e.g. SV1. Display only."
                    }
                  }
                }
              },
              "chip": {
                "description": "Short plain-English label for the annotation, shown against the segment itself. Six words or so, no codes.",
                "type": "string",
                "maxLength": 80
              },
              "severity": {
                "description": "How this segment reads in a view: `error` is the defect, `context` merely supports the conclusion.",
                "enum": [
                  "error",
                  "warning",
                  "context"
                ]
              }
            }
          },
          "maxItems": 8
        },
        "citations": {
          "description": "Reference-file rules the system relied on. Code meanings are cited from repo reference files, never recalled.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "rule"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "payer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120,
          "description": "Payer name exactly as it appears in the artifacts. RCM work is organised by payer; a worklist that cannot group by it is a list."
        },
        "billed_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Total billed on the denied claim, in dollars. This is the amount at risk and it is how a queue should be prioritised."
        },
        "date_of_service": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Earliest date of service on the claim, ISO 8601."
        },
        "filing_deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Last date a corrected claim or appeal can be filed, derived from the governing limit in the reference cards. Null when the limit cannot be established from the artifacts -- an invented deadline is worse than none, because work gets scheduled against it."
        },
        "corrected_claim": {
          "description": "The edits that turn the claim as billed into the claim that should have been sent. Expressed as segment replacements rather than a whole rewritten file, so a view can apply them to the REAL input and show that everything else is byte-identical. Absent when the resolution is a decision rather than a corrected file -- do_not_resubmit and bill_patient produce no claim.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "artifact",
            "edits"
          ],
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "enum": [
                "none",
                "ack_277ca.edi",
                "chart_note.txt",
                "claim_837p.edi",
                "eligibility_270.edi",
                "eligibility_271.edi",
                "remit_835.edi",
                "case.md",
                "human_input",
                "reference"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 400
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "required": [
                  "before",
                  "after"
                ],
                "additionalProperties": false,
                "properties": {
                  "before": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "The segment as it appears now, verbatim. An edit whose `before` is not found in the artifact is dropped, not guessed at."
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 400,
                    "description": "The segment as it should read. Empty string means delete the segment."
                  },
                  "line": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "why": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
      }
    },
    "awaiting_human": {
      "description": "Present iff status is awaiting_human. The system has stopped because the missing fact lives outside the case artifacts.",
      "type": "object",
      "required": [
        "question",
        "why_needed",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "One specific, answerable question for the human. Not `need more info`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "why_needed": {
          "description": "What the system already established, and why the answer changes the outcome.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "blocks": {
          "description": "Which scored fields cannot be determined without the answer.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "root_cause.family",
              "next_action.path"
            ]
          }
        },
        "asked_of": {
          "description": "Who can answer: the rendering provider, the payer, the patient, or internal staff.",
          "enum": [
            "provider",
            "payer",
            "patient",
            "internal"
          ]
        },
        "answer": {
          "description": "Filled in by the resume API once a human replies. Absent while still parked.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "usage": {
      "description": "Per-case accounting, summed over every model call made for this case. Copied from API usage fields, never estimated.",
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens",
        "cost_usd",
        "model",
        "effort",
        "calls"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$comment": "Must cover every effort any model in config/models.json advertises. eval/test_score.py asserts the two agree, so adding a model with a new effort level fails the suite rather than failing validation at write time, after the call has been paid for.",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "partial": {
      "description": "What the artifacts DO establish on a case that still had to stop and ask. A denial often decomposes: the defect family can be settled by the remit while the disposition turns on a fact only a human can supply. Optional -- predictions recorded before it existed simply lack it -- and only ever present alongside awaiting_human: a resolved case's findings belong in resolution.evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "fact"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "enum": [
                  "none",
                  "ack_277ca.edi",
                  "chart_note.txt",
                  "claim_837p.edi",
                  "eligibility_270.edi",
                  "eligibility_271.edi",
                  "remit_835.edi",
                  "case.md",
                  "human_input",
                  "reference"
                ]
              },
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "locator": {
                "description": "Where in the artifact, e.g. a segment id or line number.",
                "type": "string",
                "maxLength": 200
              },
              "segments": {
                "description": "The exact segments this fact rests on. Optional, and absent on the predictions recorded before segment provenance existed.",
                "type": "array",
                "maxItems": 12,
                "items": {
                  "description": "One source segment, quoted verbatim. `text` must be the line EXACTLY as it appears in the artifact, because a view anchors the annotation by matching it; a paraphrase anchors nothing and is dropped.",
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "description": "1-based line number within the artifact, if known. Used only to disambiguate when `text` occurs more than once."
                    },
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 12,
                      "description": "EDI segment id, e.g. SV1. Display only."
                    }
                  }
                }
              },
              "chip": {
                "description": "Short plain-English label for the annotation, shown against the segment itself. Six words or so, no codes.",
                "type": "string",
                "maxLength": 80
              },
              "severity": {
                "description": "How this segment reads in a view: `error` is the defect, `context` merely supports the conclusion.",
                "enum": [
                  "error",
                  "warning",
                  "context"
                ]
              }
            }
          }
        },
        "denial": {
          "description": "The adjudication codes carried on the remit, as read from the case. Null for a clean claim.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "group",
            "carc"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "enum": [
                "CO",
                "PR",
                "OA",
                "PI"
              ]
            },
            "carc": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{1,4}$"
            },
            "rarc": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z][0-9A-Za-z]{1,5}$"
            },
            "level": {
              "enum": [
                "claim",
                "line"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolution"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "awaiting_human"
              ]
            },
            {
              "required": [
                "partial"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_human"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "awaiting_human"
        ],
        "not": {
          "required": [
            "resolution"
          ]
        }
      }
    }
  ]
}
